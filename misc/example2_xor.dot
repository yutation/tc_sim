digraph Circuit {
    rankdir=LR;
    node [shape=box, style=filled];
    // Node styles
    input [shape=ellipse, fillcolor=lightgreen, label="Input"];
    output [shape=ellipse, fillcolor=lightcoral, label="Output"];
    gate [shape=box, fillcolor=lightblue, label="Gate"];
    wire [shape=circle, fillcolor=lightgray, label="Wire"];
    "input_a" [fillcolor=lightgreen, label="input_a\nINPUT"];
    "input_b" [fillcolor=lightgreen, label="input_b\nINPUT"];
    "not_a" [fillcolor=lightblue, label="not_a\nNOT"];
    "not_b" [fillcolor=lightblue, label="not_b\nNOT"];
    "and1" [fillcolor=lightblue, label="and1\nAND"];
    "and2" [fillcolor=lightblue, label="and2\nAND"];
    "or1" [fillcolor=lightblue, label="or1\nOR"];
    "output" [fillcolor=lightcoral, label="output\nOUTPUT"];
    "wire_a" [fillcolor=lightgray, label="a"];
    "wire_b" [fillcolor=lightgray, label="b"];
    "wire_not_a" [fillcolor=lightgray, label="not_a"];
    "wire_not_b" [fillcolor=lightgray, label="not_b"];
    "wire_a_not_b" [fillcolor=lightgray, label="a_not_b"];
    "wire_not_a_b" [fillcolor=lightgray, label="not_a_b"];
    "wire_xor_result" [fillcolor=lightgray, label="xor_result"];
    // Connections
    "input_a" -> "wire_a";
    "wire_a" -> "not_a";
    "wire_a" -> "and1";
    "input_b" -> "wire_b";
    "wire_b" -> "not_b";
    "wire_b" -> "and2";
    "not_a" -> "wire_not_a";
    "wire_not_a" -> "and2";
    "not_b" -> "wire_not_b";
    "wire_not_b" -> "and1";
    "and1" -> "wire_a_not_b";
    "wire_a_not_b" -> "or1";
    "and2" -> "wire_not_a_b";
    "wire_not_a_b" -> "or1";
    "or1" -> "wire_xor_result";
    "wire_xor_result" -> "output";
}