digraph Circuit {
    rankdir=LR;
    node [shape=box, style=filled];
    // Node styles
    input [shape=ellipse, fillcolor=lightgreen, label="Input"];
    output [shape=ellipse, fillcolor=lightcoral, label="Output"];
    gate [shape=box, fillcolor=lightblue, label="Gate"];
    wire [shape=circle, fillcolor=lightgray, label="Wire"];
    "input_a" [fillcolor=lightgreen, label="input_a\nINPUT"];
    "input_b" [fillcolor=lightgreen, label="input_b\nINPUT"];
    "input_cin" [fillcolor=lightgreen, label="input_cin\nINPUT"];
    "xor1" [fillcolor=lightblue, label="xor1\nXOR"];
    "xor2" [fillcolor=lightblue, label="xor2\nXOR"];
    "and1" [fillcolor=lightblue, label="and1\nAND"];
    "and2" [fillcolor=lightblue, label="and2\nAND"];
    "or1" [fillcolor=lightblue, label="or1\nOR"];
    "output_sum" [fillcolor=lightcoral, label="output_sum\nOUTPUT"];
    "output_cout" [fillcolor=lightcoral, label="output_cout\nOUTPUT"];
    "wire_a" [fillcolor=lightgray, label="a"];
    "wire_b" [fillcolor=lightgray, label="b"];
    "wire_cin" [fillcolor=lightgray, label="cin"];
    "wire_a_xor_b" [fillcolor=lightgray, label="a_xor_b"];
    "wire_sum" [fillcolor=lightgray, label="sum"];
    "wire_a_and_b" [fillcolor=lightgray, label="a_and_b"];
    "wire_cin_and_axorb" [fillcolor=lightgray, label="cin_and_axorb"];
    "wire_cout" [fillcolor=lightgray, label="cout"];
    // Connections
    "input_a" -> "wire_a";
    "wire_a" -> "xor1";
    "wire_a" -> "and1";
    "input_b" -> "wire_b";
    "wire_b" -> "xor1";
    "wire_b" -> "and1";
    "input_cin" -> "wire_cin";
    "wire_cin" -> "xor2";
    "wire_cin" -> "and2";
    "xor1" -> "wire_a_xor_b";
    "wire_a_xor_b" -> "xor2";
    "wire_a_xor_b" -> "and2";
    "xor2" -> "wire_sum";
    "wire_sum" -> "output_sum";
    "and1" -> "wire_a_and_b";
    "wire_a_and_b" -> "or1";
    "and2" -> "wire_cin_and_axorb";
    "wire_cin_and_axorb" -> "or1";
    "or1" -> "wire_cout";
    "wire_cout" -> "output_cout";
}