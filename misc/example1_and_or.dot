digraph Circuit {
    rankdir=LR;
    node [shape=box, style=filled];
    // Node styles
    input [shape=ellipse, fillcolor=lightgreen, label="Input"];
    output [shape=ellipse, fillcolor=lightcoral, label="Output"];
    gate [shape=box, fillcolor=lightblue, label="Gate"];
    wire [shape=circle, fillcolor=lightgray, label="Wire"];
    "input_x" [fillcolor=lightgreen, label="input_x\nINPUT"];
    "input_y" [fillcolor=lightgreen, label="input_y\nINPUT"];
    "input_z" [fillcolor=lightgreen, label="input_z\nINPUT"];
    "and1" [fillcolor=lightblue, label="and1\nAND"];
    "or1" [fillcolor=lightblue, label="or1\nOR"];
    "output" [fillcolor=lightcoral, label="output\nOUTPUT"];
    "wire_x" [fillcolor=lightgray, label="x"];
    "wire_y" [fillcolor=lightgray, label="y"];
    "wire_z" [fillcolor=lightgray, label="z"];
    "wire_xy" [fillcolor=lightgray, label="xy"];
    "wire_result" [fillcolor=lightgray, label="result"];
    // Connections
    "input_x" -> "wire_x";
    "wire_x" -> "and1";
    "input_y" -> "wire_y";
    "wire_y" -> "and1";
    "input_z" -> "wire_z";
    "wire_z" -> "or1";
    "and1" -> "wire_xy";
    "wire_xy" -> "or1";
    "or1" -> "wire_result";
    "wire_result" -> "output";
}