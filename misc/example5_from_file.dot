digraph Circuit {
    rankdir=LR;
    node [shape=box, style=filled];
    // Node styles
    input [shape=ellipse, fillcolor=lightgreen, label="Input"];
    output [shape=ellipse, fillcolor=lightcoral, label="Output"];
    gate [shape=box, fillcolor=lightblue, label="Gate"];
    wire [shape=circle, fillcolor=lightgray, label="Wire"];
    "input_a" [fillcolor=lightgreen, label="input_a\nINPUT"];
    "input_b" [fillcolor=lightgreen, label="input_b\nINPUT"];
    "input_c" [fillcolor=lightgreen, label="input_c\nINPUT"];
    "input_d" [fillcolor=lightgreen, label="input_d\nINPUT"];
    "output_f1" [fillcolor=lightcoral, label="output_f1\nOUTPUT"];
    "output_f2" [fillcolor=lightcoral, label="output_f2\nOUTPUT"];
    "and_ab" [fillcolor=lightblue, label="and_ab\nAND"];
    "and_cd" [fillcolor=lightblue, label="and_cd\nAND"];
    "or_f1" [fillcolor=lightblue, label="or_f1\nOR"];
    "or_a_or_b" [fillcolor=lightblue, label="or_a_or_b\nOR"];
    "or_c_or_d" [fillcolor=lightblue, label="or_c_or_d\nOR"];
    "and_f2" [fillcolor=lightblue, label="and_f2\nAND"];
    "wire_a" [fillcolor=lightgray, label="a"];
    "wire_b" [fillcolor=lightgray, label="b"];
    "wire_c" [fillcolor=lightgray, label="c"];
    "wire_d" [fillcolor=lightgray, label="d"];
    "wire_f1" [fillcolor=lightgray, label="f1"];
    "wire_f2" [fillcolor=lightgray, label="f2"];
    "wire_ab" [fillcolor=lightgray, label="ab"];
    "wire_cd" [fillcolor=lightgray, label="cd"];
    "wire_a_or_b" [fillcolor=lightgray, label="a_or_b"];
    "wire_c_or_d" [fillcolor=lightgray, label="c_or_d"];
    // Connections
    "input_a" -> "wire_a";
    "wire_a" -> "and_ab";
    "wire_a" -> "or_a_or_b";
    "input_b" -> "wire_b";
    "wire_b" -> "and_ab";
    "wire_b" -> "or_a_or_b";
    "input_c" -> "wire_c";
    "wire_c" -> "and_cd";
    "wire_c" -> "or_c_or_d";
    "input_d" -> "wire_d";
    "wire_d" -> "and_cd";
    "wire_d" -> "or_c_or_d";
    "or_f1" -> "wire_f1";
    "wire_f1" -> "output_f1";
    "and_f2" -> "wire_f2";
    "wire_f2" -> "output_f2";
    "and_ab" -> "wire_ab";
    "wire_ab" -> "or_f1";
    "and_cd" -> "wire_cd";
    "wire_cd" -> "or_f1";
    "or_a_or_b" -> "wire_a_or_b";
    "wire_a_or_b" -> "and_f2";
    "or_c_or_d" -> "wire_c_or_d";
    "wire_c_or_d" -> "and_f2";
}