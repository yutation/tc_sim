digraph Circuit {
    rankdir=LR;
    node [shape=box, style=filled];
    // Node styles
    input [shape=ellipse, fillcolor=lightgreen, label="Input"];
    output [shape=ellipse, fillcolor=lightcoral, label="Output"];
    gate [shape=box, fillcolor=lightblue, label="Gate"];
    wire [shape=circle, fillcolor=lightgray, label="Wire"];
    "input_p" [fillcolor=lightgreen, label="input_p\nINPUT"];
    "input_q" [fillcolor=lightgreen, label="input_q\nINPUT"];
    "input_r" [fillcolor=lightgreen, label="input_r\nINPUT"];
    "input_s" [fillcolor=lightgreen, label="input_s\nINPUT"];
    "and1" [fillcolor=lightblue, label="and1\nAND"];
    "and2" [fillcolor=lightblue, label="and2\nAND"];
    "or1" [fillcolor=lightblue, label="or1\nOR"];
    "or2" [fillcolor=lightblue, label="or2\nOR"];
    "or3" [fillcolor=lightblue, label="or3\nOR"];
    "and3" [fillcolor=lightblue, label="and3\nAND"];
    "output_f1" [fillcolor=lightcoral, label="output_f1\nOUTPUT"];
    "output_f2" [fillcolor=lightcoral, label="output_f2\nOUTPUT"];
    "wire_p" [fillcolor=lightgray, label="p"];
    "wire_q" [fillcolor=lightgray, label="q"];
    "wire_r" [fillcolor=lightgray, label="r"];
    "wire_s" [fillcolor=lightgray, label="s"];
    "wire_p_and_q" [fillcolor=lightgray, label="p_and_q"];
    "wire_r_and_s" [fillcolor=lightgray, label="r_and_s"];
    "wire_f1" [fillcolor=lightgray, label="f1"];
    "wire_p_or_q" [fillcolor=lightgray, label="p_or_q"];
    "wire_r_or_s" [fillcolor=lightgray, label="r_or_s"];
    "wire_f2" [fillcolor=lightgray, label="f2"];
    // Connections
    "input_p" -> "wire_p";
    "wire_p" -> "and1";
    "wire_p" -> "or2";
    "input_q" -> "wire_q";
    "wire_q" -> "and1";
    "wire_q" -> "or2";
    "input_r" -> "wire_r";
    "wire_r" -> "and2";
    "wire_r" -> "or3";
    "input_s" -> "wire_s";
    "wire_s" -> "and2";
    "wire_s" -> "or3";
    "and1" -> "wire_p_and_q";
    "wire_p_and_q" -> "or1";
    "and2" -> "wire_r_and_s";
    "wire_r_and_s" -> "or1";
    "or1" -> "wire_f1";
    "wire_f1" -> "output_f1";
    "or2" -> "wire_p_or_q";
    "wire_p_or_q" -> "and3";
    "or3" -> "wire_r_or_s";
    "wire_r_or_s" -> "and3";
    "and3" -> "wire_f2";
    "wire_f2" -> "output_f2";
}