digraph Circuit {
    rankdir=LR;
    node [style=filled];
    "input_a" [shape=box, fillcolor=lightgreen, label="a\n(IN)"];
    "input_b" [shape=box, fillcolor=lightgreen, label="b\n(IN)"];
    "not_a" [shape=triangle, fillcolor=lightblue, label="NOT\na"];
    "not_b" [shape=triangle, fillcolor=lightblue, label="NOT\nb"];
    "and1" [shape=box, fillcolor=lightblue, label="AND\nand1"];
    "and2" [shape=box, fillcolor=lightblue, label="AND\nand2"];
    "or1" [shape=ellipse, fillcolor=lightblue, label="OR\nor1"];
    "output" [shape=box, fillcolor=lightcoral, label="output\n(OUT)"];
    // Connections
    "input_a" -> "not_a";
    "input_a" -> "and1";
    "input_b" -> "not_b";
    "input_b" -> "and2";
    "not_a" -> "and2";
    "not_b" -> "and1";
    "and1" -> "or1";
    "and2" -> "or1";
    "or1" -> "output";
}